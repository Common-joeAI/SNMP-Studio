<Window x:Class="SNMP.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SNMP Studio" Height="920" Width="1480"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        AllowDrop="True"
        DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">

    <!--
        Converters BoolVis and NullVis are declared in App.xaml and available globally.
        No need to redeclare them here.
    -->
    <Window.Resources>

        <!-- Palette -->
        <SolidColorBrush x:Key="BgBase"      Color="#0F1117"/>
        <SolidColorBrush x:Key="BgSurface"   Color="#181C27"/>
        <SolidColorBrush x:Key="BgCard"      Color="#1E2235"/>
        <SolidColorBrush x:Key="BgInput"     Color="#252A3D"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#4F8EF7"/>
        <SolidColorBrush x:Key="AccentRed"   Color="#E05260"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#34D399"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F3F9"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8B92A8"/>
        <SolidColorBrush x:Key="BorderClr"   Color="#2A2F45"/>

        <!-- Pill button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background"      Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="13,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter TargetName="bg" Property="Opacity" Value="0.3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnRed"   BasedOn="{StaticResource Btn}" TargetType="Button"><Setter Property="Background" Value="{StaticResource AccentRed}"/></Style>
        <Style x:Key="BtnAmber" BasedOn="{StaticResource Btn}" TargetType="Button"><Setter Property="Background" Value="{StaticResource AccentAmber}"/><Setter Property="Foreground" Value="#111"/></Style>
        <Style x:Key="BtnGhost" BasedOn="{StaticResource Btn}" TargetType="Button"><Setter Property="Background" Value="#252A3D"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/></Style>
        <Style x:Key="BtnGreen" BasedOn="{StaticResource Btn}" TargetType="Button"><Setter Property="Background" Value="{StaticResource AccentGreen}"/><Setter Property="Foreground" Value="#111"/></Style>
        <Style x:Key="BtnSm"    BasedOn="{StaticResource Btn}" TargetType="Button"><Setter Property="Padding" Value="9,4"/><Setter Property="FontSize" Value="11"/></Style>

        <!-- Input -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderClr}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Combo -->
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderClr}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,6,0"/>
        </Style>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderClr}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
        </Style>

        <!-- Card header bar -->
        <Style x:Key="CardHdr" TargetType="Border">
            <Setter Property="Background"      Value="#13172A"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderClr}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="14,9"/>
        </Style>

        <!-- Section header text -->
        <Style x:Key="SHdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Dark DataGrid -->
        <Style x:Key="DGrid" TargetType="DataGrid">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1A1E2D"/>
            <Setter Property="RowBackground"            Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#191D2C"/>
            <Setter Property="CanUserSortColumns"       Value="True"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="EnableRowVirtualization"  Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing"     Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="#13172A"/>
                        <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
                        <Setter Property="FontSize"        Value="10"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="Padding"         Value="10,8"/>
                        <Setter Property="BorderBrush"     Value="#2A2F45"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#252A3D"/></Trigger>
                            <Trigger Property="IsSelected"  Value="True"><Setter Property="Background" Value="#1A3055"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding"         Value="10,5"/>
                        <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav button -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="GroupName"       Value="Nav"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="7" Margin="4,1"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"  Value="True"><Setter TargetName="bg" Property="Background" Value="#252A3D"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#1E2235"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat chip -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background"   Value="#1A2840"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding"      Value="11,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════ SIDEBAR ════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderClr}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,14">
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBlue}">
                        SNMP<Run Foreground="{StaticResource TextPrimary}" FontWeight="Light"> Studio</Run>
                    </TextBlock>
                    <TextBlock Text="v1.1" FontSize="10"
                               Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Stat chips -->
                <WrapPanel DockPanel.Dock="Top" Margin="10,0,10,14">
                    <Border Style="{StaticResource Chip}" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding MibModules.Count, StringFormat='{}{0} mod'}"
                                       Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding MibCount, StringFormat='{}{0} nodes'}"
                                       Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="2"
                            Visibility="{Binding TrapListening, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentRed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding TrapCount, StringFormat='T:{0}'}"
                                       Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderClr}" Margin="12,0,12,10"/>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0">
                    <RadioButton Style="{StaticResource Nav}" Tag="📡" IsChecked="True" x:Name="NavResults">Results</RadioButton>
                    <RadioButton Style="{StaticResource Nav}" Tag="📋" x:Name="NavTable">Table View</RadioButton>
                    <RadioButton Style="{StaticResource Nav}" Tag="🌐" x:Name="NavDiscover">Discovery</RadioButton>
                    <RadioButton Style="{StaticResource Nav}" Tag="📟" x:Name="NavTraps">Trap Receiver</RadioButton>
                    <RadioButton Style="{StaticResource Nav}" Tag="📈" x:Name="NavPoll">Live Poll</RadioButton>
                    <RadioButton Style="{StaticResource Nav}" Tag="📚" x:Name="NavMib">MIB Manager</RadioButton>
                    <RadioButton Style="{StaticResource Nav}" Tag="🔐" x:Name="NavV3">SNMPv3 Profiles</RadioButton>
                    <RadioButton Style="{StaticResource Nav}" Tag="⭐" x:Name="NavFavs">Favourites</RadioButton>
                    <RadioButton Style="{StaticResource Nav}" Tag="🖧"  x:Name="NavTargets">Saved Targets</RadioButton>
                </StackPanel>

                <!-- Recent targets quick list -->
                <StackPanel DockPanel.Dock="Top" Margin="8,10,8,0">
                    <Border Height="1" Background="{StaticResource BorderClr}" Margin="4,0,4,8"/>
                    <TextBlock Text="RECENT" Style="{StaticResource Lbl}" Margin="14,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding SavedTargets}" MaxHeight="150">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Padding="14,5" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.LoadTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,7,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Host}"  FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Write Mode toggle -->
                <Border DockPanel.Dock="Bottom" Margin="10,0,10,14" CornerRadius="8"
                        Background="#1A1020" BorderBrush="#3A2040" BorderThickness="1" Padding="12,10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Write Mode" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding WriteModeEnabled}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Margin="0,8,0,0" CornerRadius="4" Padding="8,4" Background="#3D1010"
                                Visibility="{Binding WriteModeEnabled, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="⚠ Active — caution" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentRed}" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Rectangle/>
            </DockPanel>
        </Border>

        <!-- ════ MAIN AREA ══════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="1">

            <!-- Status bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderClr}" BorderThickness="0,0,0,1" Padding="20,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="70" Height="3" Margin="0,0,12,0"
                                     Foreground="{StaticResource AccentBlue}" Background="Transparent"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        <Border Style="{StaticResource Chip}" Margin="0,0,7,0">
                            <TextBlock Text="{Binding OidCount, StringFormat='OIDs: {0}'}"
                                       Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock Text="{Binding Elapsed, StringFormat='⏱ {0}'}"
                                       Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}"
                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- MIB drag overlay -->
            <Border DockPanel.Dock="Top" Padding="0,8" Background="#112040"
                    Visibility="{Binding IsDragOver, Converter={StaticResource BoolVis}}">
                <TextBlock Text="📂  Drop MIB files to import" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
            </Border>

            <!-- ── Connection + action card ──────────────────────────────── -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="18,14,18,0" Padding="16,13">
                <StackPanel>
                    <!-- v1/v2c fields -->
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="HOST" Style="{StaticResource Lbl}"/>
                            <TextBox Style="{StaticResource Input}" Width="160"
                                     Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="PORT" Style="{StaticResource Lbl}"/>
                            <TextBox Style="{StaticResource Input}" Width="52"
                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="VER" Style="{StaticResource Lbl}"/>
                            <ComboBox Style="{StaticResource Combo}" Width="80"
                                      ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6"
                                    Visibility="{Binding IsV3, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                            <TextBlock Text="COMMUNITY" Style="{StaticResource Lbl}"/>
                            <TextBox Style="{StaticResource Input}" Width="105"
                                     Text="{Binding Community, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="ROOT OID" Style="{StaticResource Lbl}"/>
                            <TextBox Style="{StaticResource Input}" Width="185"
                                     Text="{Binding RootOid, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Style="{StaticResource BtnAmber}" Content="⚡ Auto-Detect"
                                Command="{Binding NegotiateCommand}" Margin="0,0,0,6"/>
                    </WrapPanel>

                    <!-- SNMPv3 inline credential row -->
                    <Border Background="#1A1530" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                            Visibility="{Binding IsV3, Converter={StaticResource BoolVis}}">
                        <WrapPanel>
                            <TextBlock Text="🔐 v3" Foreground="{StaticResource AccentBlue}" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <TextBlock Text="USER" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource Input}" Width="120"
                                         Text="{Binding V3SecurityName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                <TextBlock Text="AUTH" Style="{StaticResource Lbl}"/>
                                <ComboBox Style="{StaticResource Combo}" Width="82"
                                          ItemsSource="{Binding AuthProtocols}" SelectedItem="{Binding V3AuthProto}"/>
                            </StackPanel>
                            <TextBox Style="{StaticResource Input}" Width="110"
                                     Text="{Binding V3AuthPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                <TextBlock Text="PRIV" Style="{StaticResource Lbl}"/>
                                <ComboBox Style="{StaticResource Combo}" Width="88"
                                          ItemsSource="{Binding PrivProtocols}" SelectedItem="{Binding V3PrivProto}"/>
                            </StackPanel>
                            <TextBox Style="{StaticResource Input}" Width="110"
                                     Text="{Binding V3PrivPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CTX" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource Input}" Width="100"
                                         Text="{Binding V3ContextName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Height="1" Background="{StaticResource BorderClr}" Margin="0,8,0,10"/>

                    <!-- Action buttons -->
                    <WrapPanel>
                        <Button Style="{StaticResource Btn}"      Content="▶ Walk"         Command="{Binding WalkCommand}"             Margin="0,0,7,0"/>
                        <Button Style="{StaticResource Btn}"      Content="↓ GET"           Command="{Binding GetCommand}"              Margin="0,0,7,0"/>
                        <Button Style="{StaticResource BtnRed}"   Content="✕ Cancel"        Command="{Binding CancelCommand}"           Margin="0,0,16,0"/>
                        <Button Style="{StaticResource BtnGhost}" Content="🖨 Printer"       Command="{Binding PrinterQuickViewCommand}" Margin="0,0,16,0"/>
                        <Button Style="{StaticResource BtnGhost}" Content="CSV"            Command="{Binding ExportCsvCommand}"        Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnGhost}" Content="JSON"           Command="{Binding ExportJsonCommand}"       Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnAmber}" Content="📦 Bundle"      Command="{Binding ExportBundleCommand}"     Margin="0,0,16,0"/>
                        <TextBox Style="{StaticResource Input}" Width="120"
                                 Text="{Binding SaveTargetLabel, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnGhost}" Content="💾 Save Target" Command="{Binding SaveTargetCommand}"       Margin="0,0,16,0"/>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                        <TextBox Style="{StaticResource Input}" Width="160" FontSize="11"
                                 Text="{Binding ResultFilter, UpdateSourceTrigger=PropertyChanged}"/>
                    </WrapPanel>

                    <!-- SET row (write mode only) -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding WriteModeEnabled, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="SET OID" Style="{StaticResource Lbl}"/>
                        <TextBox Style="{StaticResource Input}" Width="170" Text="{Binding SetOid}" Margin="0,0,8,0"/>
                        <ComboBox Style="{StaticResource Combo}" Width="90" SelectedValue="{Binding SetType}" Margin="0,0,8,0">
                            <ComboBoxItem Content="INTEGER"/>
                            <ComboBoxItem Content="STRING"/>
                            <ComboBoxItem Content="OID"/>
                            <ComboBoxItem Content="TIMETICKS"/>
                            <ComboBoxItem Content="GAUGE"/>
                            <ComboBoxItem Content="COUNTER"/>
                        </ComboBox>
                        <TextBox Style="{StaticResource Input}" Width="130" Text="{Binding SetValue}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource BtnRed}" Content="⚡ SET" Command="{Binding SetCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Page area ─────────────────────────────────────────────── -->
            <Grid Margin="18,14,18,18">

                <!-- ══ RESULTS ═════════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavResults, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="1*" MinHeight="90"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Query Results" Style="{StaticResource SHdr}"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource BtnSm}" Content="⭐ Favourite"
                                                Command="{Binding AddFavouriteCommand}" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource BtnSm}" Content="📋 Copy Row"
                                                Command="{Binding CopyRowCommand}"
                                                CommandParameter="{Binding SelectedResult}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataGrid Style="{StaticResource DGrid}"
                                      ItemsSource="{Binding FilteredResults}"
                                      SelectedItem="{Binding SelectedResult}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Background="{StaticResource BgCard}"
                                                 BorderBrush="{StaticResource BorderClr}">
                                        <MenuItem Header="⭐  Add to Favourites" Foreground="{StaticResource TextPrimary}"
                                                  Command="{Binding DataContext.AddFavouriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="📋  Copy Row" Foreground="{StaticResource TextPrimary}"
                                                  Command="{Binding DataContext.CopyRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="📌  Copy OID" Foreground="{StaticResource TextPrimary}"
                                                  Command="{Binding DataContext.CopyOidCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="📈  Add to Live Poll" Foreground="{StaticResource TextPrimary}"
                                                  Command="{Binding DataContext.AddFavouriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="OID"           Binding="{Binding Oid}"          Width="200"/>
                                    <DataGridTextColumn Header="Symbolic Name" Binding="{Binding SymbolicName}" Width="175"/>
                                    <DataGridTextColumn Header="Raw Value"     Binding="{Binding RawValue}"     Width="130"/>
                                    <DataGridTextColumn Header="Human Value"   Binding="{Binding HumanValue}"   Width="170"/>
                                    <DataGridTextColumn Header="Type"          Binding="{Binding Type}"         Width="100"/>
                                    <DataGridTextColumn Header="Description"   Binding="{Binding Description}"  Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Background="#13172A" Height="36" LastChildFill="False">
                                <TextBlock Text="Diagnostics Log" VerticalAlignment="Center" Margin="14,0"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}"
                                        Background="{StaticResource AccentRed}" Content="Clear"
                                        Margin="8,0" VerticalAlignment="Center" Command="{Binding ClearLogCommand}"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent"
                                     BorderThickness="0" VirtualizingPanel.IsVirtualizing="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="12,6">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background"      Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding"         Value="0,1"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Cascadia Code,Consolas" FontSize="11"
                                                   Text="{Binding}" Foreground="#6A7ACC" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ══ TABLE VIEW ══════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavTable, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="QUICK JUMP — KNOWN TABLES" Style="{StaticResource Lbl}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding KnownTables}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BtnGhost}" Margin="0,0,6,6"
                                                Content="{Binding Item1}" FontSize="11" Padding="10,5"
                                                Command="{Binding DataContext.WalkTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Item2}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Style="{StaticResource SHdr}"
                                               Text="{Binding SelectedTable.TableName,
                                                      FallbackValue='No table detected — run a Walk on a table OID first'}"/>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               Text="{Binding SelectedTable.Rows.Count, StringFormat='{}{0} rows'}"/>
                                </DockPanel>
                            </Border>
                            <!-- Auto-generate columns from SnmpTableRow.Cells dictionary -->
                            <DataGrid Style="{StaticResource DGrid}"
                                      ItemsSource="{Binding TableRows}"
                                      AutoGenerateColumns="True"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ══ DISCOVERY ═══════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavDiscover, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── Control bar ────────────────────────────────────── -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13">
                        <StackPanel>
                            <WrapPanel>
                                <!-- Subnet / CIDR input -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    <TextBlock Style="{StaticResource Lbl}">
                                        <Run Text="SUBNET(S)"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource Input}" Width="380"
                                             Text="{Binding DiscoveryCidr, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="One or more subnets. Examples:&#x0a;  192.168.1.0/24&#x0a;  192.168.1.0/24, 10.10.5.0/24&#x0a;  Floor 1=192.168.1.0/24, Floor 2=192.168.2.0/24"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    <TextBlock Text="COMMUNITIES" Style="{StaticResource Lbl}"/>
                                    <TextBox Style="{StaticResource Input}" Width="170"
                                             Text="{Binding DiscoveryCommunities, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <Button Style="{StaticResource BtnGreen}" Content="▶ Scan"
                                        Command="{Binding StartDiscoveryCommand}" Margin="0,0,7,6"/>
                                <Button Style="{StaticResource BtnRed}"   Content="✕ Cancel"
                                        Command="{Binding CancelDiscoveryCommand}" Margin="0,0,14,6"/>
                                <!-- Group-by-subnet toggle -->
                                <Border CornerRadius="6" Padding="10,5" Margin="0,0,12,6"
                                        Background="{Binding GroupBySubnet, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1E2235"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GroupBySubnet}" Value="True">
                                                    <Setter Property="Background" Value="#1A3055"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding GroupBySubnet}"
                                                  VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Group by Subnet" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- Stats chips -->
                                <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <TextBlock Text="{Binding DiscoveryCount, StringFormat='🔍 {0} found'}"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </Border>
                                <!-- Filter box -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource Input}" Width="150" FontSize="11"
                                             Text="{Binding DiscoveryFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Subnet hint -->
                            <Border Background="#111820" CornerRadius="5" Padding="10,5" Margin="0,6,0,0">
                                <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}">
                                    <Run FontWeight="SemiBold" Foreground="#4F8EF7">Tip: </Run>
                                    <Run>Label subnets by location — e.g. </Run>
                                    <Run Foreground="#4F8EF7" FontFamily="Consolas">Floor 1=192.168.1.0/24, Floor 2=192.168.2.0/24, Warehouse=10.10.5.0/24</Run>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── Results area (grouped OR flat) ─────────────────── -->
                    <Grid Grid.Row="2">

                        <!-- ═══ GROUP-BY-SUBNET VIEW ══════════════════════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding GroupBySubnet, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding SubnetGroups}" Margin="0,0,4,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- One card per subnet -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                            <DockPanel>

                                                <!-- Subnet header — click to expand/collapse -->
                                                <Border DockPanel.Dock="Top" CornerRadius="10,10,0,0"
                                                        Padding="14,10" Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#13172A"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1A1F30"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ToggleSubnetGroupCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <DockPanel LastChildFill="False">
                                                        <!-- Expand chevron -->
                                                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                                                   Margin="0,0,10,0" FontSize="12"
                                                                   Foreground="{StaticResource TextMuted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="▼"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                            <Setter Property="Text" Value="▶"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- Subnet label + CIDR -->
                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🌐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DisplayHeader}"
                                                                       FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <!-- Summary chips (right side) -->
                                                        <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Style="{StaticResource Chip}" Margin="4,0,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreen}"
                                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="{Binding ReachableCount, StringFormat='{}{0} up'}"
                                                                               Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}" Margin="4,0,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBlue}"
                                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="{Binding SnmpCount, StringFormat='{}{0} SNMP'}"
                                                                               Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}" Margin="4,0,0,0"
                                                                    Visibility="{Binding PrinterCount, Converter={StaticResource IntVis}}">
                                                                <TextBlock Text="{Binding PrinterCount, StringFormat='🖨 {0}'}"
                                                                           Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}" Margin="4,0,0,0"
                                                                    Visibility="{Binding SwitchCount, Converter={StaticResource IntVis}}">
                                                                <TextBlock Text="{Binding SwitchCount, StringFormat='🔀 {0}'}"
                                                                           Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}" Margin="4,0,0,0">
                                                                <TextBlock Text="{Binding Hosts.Count, StringFormat='{}{0} hosts'}"
                                                                           Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Host DataGrid (collapsible) -->
                                                <DataGrid Style="{StaticResource DGrid}"
                                                          ItemsSource="{Binding Hosts}"
                                                          SelectedItem="{Binding DataContext.SelectedDiscoveredHost,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          MaxHeight="340" MinHeight="36"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Reachable}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.30"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderClr}">
                                                            <MenuItem Header="🔌  Connect to this host"
                                                                      Foreground="{StaticResource TextPrimary}"
                                                                      Command="{Binding DataContext.ConnectDiscoveredCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="IP"        Binding="{Binding IpAddress}"     Width="130"/>
                                                        <DataGridTextColumn Header="Hostname"  Binding="{Binding Hostname}"      Width="185"/>
                                                        <DataGridTextColumn Header="Type"      Binding="{Binding DeviceType}"    Width="110"/>
                                                        <DataGridTextColumn Header="Ver"       Binding="{Binding BestVersion}"   Width="60"/>
                                                        <DataGridTextColumn Header="Community" Binding="{Binding BestCommunity}" Width="90"/>
                                                        <DataGridTextColumn Header="ms"        Binding="{Binding ResponseMs}"    Width="50"/>
                                                        <DataGridTextColumn Header="sysName"   Binding="{Binding SysName}"       Width="150"/>
                                                        <DataGridTextColumn Header="sysDescr"  Binding="{Binding SysDescr}"      Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- ═══ FLAT VIEW (Group-by-Subnet off) ═══════════════ -->
                        <Border Style="{StaticResource Card}" ClipToBounds="True"
                                Visibility="{Binding GroupBySubnet, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                    <TextBlock Text="{Binding DiscoveryCount, StringFormat='Discovered Hosts ({0})'}"
                                               Style="{StaticResource SHdr}"/>
                                </Border>
                                <DataGrid Style="{StaticResource DGrid}"
                                          ItemsSource="{Binding FilteredDiscoveredHosts}"
                                          SelectedItem="{Binding SelectedDiscoveredHost}">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Reachable}" Value="False">
                                                    <Setter Property="Opacity" Value="0.30"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderClr}">
                                            <MenuItem Header="🔌  Connect to this host"
                                                      Foreground="{StaticResource TextPrimary}"
                                                      Command="{Binding DataContext.ConnectDiscoveredCommand,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="IP"        Binding="{Binding IpAddress}"     Width="130"/>
                                        <DataGridTextColumn Header="Subnet"    Binding="{Binding SourceSubnet}"  Width="140"/>
                                        <DataGridTextColumn Header="Hostname"  Binding="{Binding Hostname}"      Width="170"/>
                                        <DataGridTextColumn Header="Type"      Binding="{Binding DeviceType}"    Width="110"/>
                                        <DataGridTextColumn Header="Ver"       Binding="{Binding BestVersion}"   Width="60"/>
                                        <DataGridTextColumn Header="Community" Binding="{Binding BestCommunity}" Width="90"/>
                                        <DataGridTextColumn Header="ms"        Binding="{Binding ResponseMs}"    Width="50"/>
                                        <DataGridTextColumn Header="sysName"   Binding="{Binding SysName}"       Width="150"/>
                                        <DataGridTextColumn Header="sysDescr"  Binding="{Binding SysDescr}"      Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ══ TRAP RECEIVER ═══════════════════════════════════════ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavTraps, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="1*" MinHeight="100"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="PORT" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource Input}" Width="66"
                                         Text="{Binding TrapPort, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Style="{StaticResource BtnGreen}" Content="▶ Start Listening"
                                    Command="{Binding StartTrapCommand}" Margin="0,0,7,0"/>
                            <Button Style="{StaticResource BtnRed}"   Content="⏹ Stop"
                                    Command="{Binding StopTrapCommand}" Margin="0,0,7,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="🗑 Clear"
                                    Command="{Binding ClearTrapsCommand}" Margin="0,0,14,0"/>
                            <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrapListening}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding TrapCount, StringFormat='Traps: {0}'}"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource Input}" Width="160" FontSize="11"
                                         Text="{Binding TrapFilter, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    <!-- Trap list -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                <TextBlock Text="{Binding TrapCount, StringFormat='Received Traps ({0})'}"
                                           Style="{StaticResource SHdr}"/>
                            </Border>
                            <DataGrid Style="{StaticResource DGrid}"
                                      ItemsSource="{Binding FilteredTraps}"
                                      SelectedItem="{Binding SelectedTrap}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time"      Binding="{Binding ReceivedAt, StringFormat='HH:mm:ss'}" Width="75"/>
                                    <DataGridTextColumn Header="Source"    Binding="{Binding SourceIp}"    Width="130"/>
                                    <DataGridTextColumn Header="Version"   Binding="{Binding Version}"     Width="65"/>
                                    <DataGridTextColumn Header="Community" Binding="{Binding Community}"   Width="100"/>
                                    <DataGridTextColumn Header="Trap Name" Binding="{Binding TrapName}"    Width="200"/>
                                    <DataGridTextColumn Header="Trap OID"  Binding="{Binding TrapOid}"     Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <!-- Var-bind drill-down -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                <TextBlock Text="Var-Binds  — select a trap row above" Style="{StaticResource SHdr}"/>
                            </Border>
                            <DataGrid Style="{StaticResource DGrid}" ItemsSource="{Binding SelectedTrapVarBinds}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="OID"           Binding="{Binding Oid}"          Width="200"/>
                                    <DataGridTextColumn Header="Symbolic Name" Binding="{Binding SymbolicName}" Width="200"/>
                                    <DataGridTextColumn Header="Value"         Binding="{Binding Value}"        Width="200"/>
                                    <DataGridTextColumn Header="Type"          Binding="{Binding Type}"         Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ══ LIVE POLL ═══════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavPoll, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="1*" MinHeight="80"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="2*" MinHeight="160"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="OID" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource Input}" Width="240"
                                         Text="{Binding PollOid, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="INTERVAL (s)" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource Input}" Width="58"
                                         Text="{Binding PollIntervalSecs, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Style="{StaticResource BtnGreen}" Content="＋ Add Poll"
                                    Command="{Binding AddPollCommand}" Margin="0,0,7,0"/>
                            <Button Style="{StaticResource BtnRed}"   Content="− Remove"
                                    Command="{Binding RemovePollCommand}"/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                <TextBlock Text="Active Polls — click a row to view its chart below" Style="{StaticResource SHdr}"/>
                            </Border>
                            <DataGrid Style="{StaticResource DGrid}"
                                      ItemsSource="{Binding PollSeries}"
                                      SelectedItem="{Binding SelectedPoll}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Label"      Binding="{Binding Label}"                              Width="220"/>
                                    <DataGridTextColumn Header="OID"        Binding="{Binding Oid}"                                Width="200"/>
                                    <DataGridTextColumn Header="Interval"   Binding="{Binding IntervalSecs, StringFormat='{}{0}s'}" Width="75"/>
                                    <DataGridTextColumn Header="Last Value" Binding="{Binding LastValue}"                          Width="160"/>
                                    <DataGridTextColumn Header="Samples"    Binding="{Binding Points.Count}"                       Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <!-- OxyPlot chart -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                <TextBlock Style="{StaticResource SHdr}"
                                           Text="{Binding SelectedPoll.Label,
                                                  FallbackValue='Select a poll above to view chart'}"/>
                            </Border>
                            <oxy:PlotView Model="{Binding ChartModel}" Background="#1E2235"
                                          Visibility="{Binding ChartModel, Converter={StaticResource NullVis}}"/>
                            <TextBlock Text="No data yet — add a poll and wait for samples."
                                       Foreground="{StaticResource TextMuted}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ChartModel, Converter={StaticResource NullVis}, ConverterParameter=Inverse}"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ══ MIB MANAGER ═════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavMib, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Module list -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" ClipToBounds="True">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="Loaded Modules" Style="{StaticResource SHdr}"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}"
                                                Background="{StaticResource AccentRed}" Content="🗑 Remove"
                                                Command="{Binding RemoveModuleCommand}" Margin="0,0,6,0"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}"
                                                Content="📂 Import" Command="{Binding ImportMibCommand}" Margin="0,0,6,0"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid Style="{StaticResource DGrid}"
                                          ItemsSource="{Binding MibModules}"
                                          SelectedItem="{Binding SelectedModule}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="180"/>
                                        <DataGridTextColumn Header="Nodes"  Binding="{Binding NodeCount}"  Width="65"/>
                                        <DataGridTextColumn Header="Source" Binding="{Binding Summary}"    Width="100"/>
                                        <DataGridTextColumn Header="Path"   Binding="{Binding SourcePath}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <!-- OID Browser -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="OID Browser  (double-click to set Root OID)" Style="{StaticResource SHdr}"/>
                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Input}" Width="160"
                                                 Margin="0,1,0,1" FontSize="11"
                                                 Text="{Binding TreeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid Style="{StaticResource DGrid}" ItemsSource="{Binding FilteredTree}">
                                    <DataGrid.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding SetRootOidFromTreeCommand}"
                                                      CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"/>
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="OID"    Binding="{Binding NumericOid}" Width="180"/>
                                        <DataGridTextColumn Header="Name"   Binding="{Binding Name}"       Width="160"/>
                                        <DataGridTextColumn Header="Syntax" Binding="{Binding Syntax}"     Width="110"/>
                                        <DataGridTextColumn Header="Access" Binding="{Binding Access}"     Width="90"/>
                                        <DataGridTextColumn Header="Desc"   Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <!-- Drop zone panel -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <Border CornerRadius="8" Padding="14,20" Margin="0,0,0,16" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"    Value="#181C27"/>
                                        <Setter Property="BorderBrush"   Value="#2A2F45"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                                <Setter Property="Background"  Value="#0D1F40"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📂" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Drop MIB files here" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,7,0,3"/>
                                    <TextBlock Text=".mib  ·  .my  ·  .txt" FontSize="11"
                                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Btn}" Content="📂  Import File(s)" HorizontalAlignment="Stretch"
                                    Command="{Binding ImportMibCommand}" Margin="0,0,0,7"/>
                            <Button Style="{StaticResource BtnAmber}" Content="⬛  Clear All Cache" HorizontalAlignment="Stretch"
                                    Command="{Binding ClearMibCacheCommand}" Foreground="#111"/>
                            <Border Height="1" Background="{StaticResource BorderClr}" Margin="0,16"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Modules"     Foreground="{StaticResource TextMuted}" FontSize="12" Width="80"/>
                                <TextBlock Foreground="{StaticResource AccentBlue}"  FontSize="12" FontWeight="SemiBold"
                                           Text="{Binding MibModules.Count}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total nodes" Foreground="{StaticResource TextMuted}" FontSize="12" Width="80"/>
                                <TextBlock Foreground="{StaticResource AccentGreen}" FontSize="12" FontWeight="SemiBold"
                                           Text="{Binding MibCount}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ SNMPv3 PROFILES ═════════════════════════════════════ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavV3, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="CREATE / EDIT PROFILE" Style="{StaticResource Lbl}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                    <TextBlock Text="LABEL" Style="{StaticResource Lbl}"/>
                                    <TextBox Style="{StaticResource Input}" Width="130"
                                             Text="{Binding V3ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                    <TextBlock Text="USER" Style="{StaticResource Lbl}"/>
                                    <TextBox Style="{StaticResource Input}" Width="130"
                                             Text="{Binding V3SecurityName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                    <TextBlock Text="AUTH" Style="{StaticResource Lbl}"/>
                                    <ComboBox Style="{StaticResource Combo}" Width="90"
                                              ItemsSource="{Binding AuthProtocols}" SelectedItem="{Binding V3AuthProto}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                    <TextBlock Text="AUTH PASS" Style="{StaticResource Lbl}"/>
                                    <TextBox Style="{StaticResource Input}" Width="130"
                                             Text="{Binding V3AuthPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                    <TextBlock Text="PRIV" Style="{StaticResource Lbl}"/>
                                    <ComboBox Style="{StaticResource Combo}" Width="90"
                                              ItemsSource="{Binding PrivProtocols}" SelectedItem="{Binding V3PrivProto}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                    <TextBlock Text="PRIV PASS" Style="{StaticResource Lbl}"/>
                                    <TextBox Style="{StaticResource Input}" Width="130"
                                             Text="{Binding V3PrivPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                    <TextBlock Text="CONTEXT" Style="{StaticResource Lbl}"/>
                                    <TextBox Style="{StaticResource Input}" Width="100"
                                             Text="{Binding V3ContextName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <Button Style="{StaticResource BtnGreen}" Content="💾 Save Profile"
                                        Command="{Binding SaveV3ProfileCommand}" Margin="0,0,7,6"/>
                                <Button Style="{StaticResource BtnRed}"   Content="🗑 Delete"
                                        Command="{Binding DeleteV3ProfileCommand}" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <Border Background="#1A1530" CornerRadius="6" Padding="10,7" Margin="0,6,0,0">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
                                    🔒  Passwords are encrypted with Windows DPAPI (CurrentUser scope).
                                    They are never stored in plaintext. Double-click a profile to load it.
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                                <TextBlock Text="Saved SNMPv3 Profiles" Style="{StaticResource SHdr}"/>
                            </Border>
                            <DataGrid Style="{StaticResource DGrid}"
                                      ItemsSource="{Binding V3Profiles}"
                                      SelectedItem="{Binding SelectedV3Profile}">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding LoadV3ProfileCommand}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Label"      Binding="{Binding Name}"         Width="160"/>
                                    <DataGridTextColumn Header="User"       Binding="{Binding SecurityName}" Width="160"/>
                                    <DataGridTextColumn Header="Auth Proto" Binding="{Binding AuthProtocol}" Width="100"/>
                                    <DataGridTextColumn Header="Priv Proto" Binding="{Binding PrivProtocol}" Width="100"/>
                                    <DataGridTextColumn Header="Context"    Binding="{Binding ContextName}"  Width="120"/>
                                    <DataGridTextColumn Header="Created"    Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd'}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ══ FAVOURITES ══════════════════════════════════════════ -->
                <Border Style="{StaticResource Card}" ClipToBounds="True"
                        Visibility="{Binding IsChecked, ElementName=NavFavs, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                            <TextBlock Text="⭐  Favourite OIDs" Style="{StaticResource SHdr}"/>
                        </Border>
                        <DataGrid Style="{StaticResource DGrid}" ItemsSource="{Binding FavouriteOids}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="OID"           Binding="{Binding Oid}"          Width="200"/>
                                <DataGridTextColumn Header="Symbolic Name" Binding="{Binding SymbolicName}" Width="200"/>
                                <DataGridTextColumn Header="Last Value"    Binding="{Binding HumanValue}"   Width="175"/>
                                <DataGridTextColumn Header="Type"          Binding="{Binding Type}"         Width="100"/>
                                <DataGridTextColumn Header="Description"   Binding="{Binding Description}"  Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- ══ SAVED TARGETS ═══════════════════════════════════════ -->
                <Border Style="{StaticResource Card}" ClipToBounds="True"
                        Visibility="{Binding IsChecked, ElementName=NavTargets, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHdr}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="🖧  Saved Targets" Style="{StaticResource SHdr}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}"
                                        Background="{StaticResource AccentRed}" Content="🗑 Delete"
                                        Command="{Binding DeleteTargetCommand}"/>
                            </DockPanel>
                        </Border>
                        <DataGrid Style="{StaticResource DGrid}"
                                  ItemsSource="{Binding SavedTargets}"
                                  SelectedItem="{Binding SelectedSavedTarget}">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderClr}">
                                    <MenuItem Header="🔌  Connect" Foreground="{StaticResource TextPrimary}"
                                              Command="{Binding DataContext.LoadTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="🗑  Delete" Foreground="{StaticResource TextPrimary}"
                                              Command="{Binding DataContext.DeleteTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Icon"      Binding="{Binding Icon}"      Width="45"/>
                                <DataGridTextColumn Header="Label"     Binding="{Binding Label}"     Width="170"/>
                                <DataGridTextColumn Header="Host"      Binding="{Binding Host}"      Width="155"/>
                                <DataGridTextColumn Header="Port"      Binding="{Binding Port}"      Width="55"/>
                                <DataGridTextColumn Header="Version"   Binding="{Binding Version}"   Width="75"/>
                                <DataGridTextColumn Header="Community" Binding="{Binding Community}" Width="110"/>
                                <DataGridTextColumn Header="Last Used" Binding="{Binding LastUsed, StringFormat='yyyy-MM-dd HH:mm'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
