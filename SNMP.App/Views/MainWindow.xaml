<Window x:Class="SNMP.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SNMP Studio v1.0 — Network Device Browser"
        Height="820" Width="1280" MinHeight="600" MinWidth="900"
        Background="#F0F2F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#0A2D6E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding"    Value="12,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A4D9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#AABBCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>
        <Style TargetType="Button" x:Key="WarnBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#D4800A"/>
        </Style>
        <Style TargetType="TextBox" x:Key="InputBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Label" x:Key="FieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ── Title Bar ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#0A2D6E" Padding="16,8">
            <DockPanel>
                <TextBlock Text="SNMP Studio" FontSize="18" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text=" v1.0" FontSize="14" Foreground="#7AABFF"
                           VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="#AACCFF" FontSize="12"
                           Text="{Binding MibCount, StringFormat='MIB nodes: {0}'}"/>
            </DockPanel>
        </Border>

        <!-- ── Write Mode Warning Banner ─────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#C0392B" Padding="12,6"
                Visibility="{Binding WriteModeEnabled, Converter={StaticResource BoolVis}}">
            <TextBlock Text="⚠  WRITE MODE ENABLED — SET operations are active. Use with caution."
                       Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- ── Status Bar ────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="#E8EBF0" BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="{Binding OidCount, StringFormat='OIDs: {0}'}"
                               VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12"/>
                    <TextBlock Text="{Binding Elapsed, StringFormat='Elapsed: {0}'}"
                               VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Width="120" Height="8"
                             DockPanel.Dock="Right" Margin="16,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
            </DockPanel>
        </Border>

        <!-- ── Main Content ───────────────────────────────────────────────── -->
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Connection panel -->
                <RowDefinition Height="Auto"/>  <!-- Action bar -->
                <RowDefinition Height="*"/>     <!-- Results + logs splitter -->
            </Grid.RowDefinitions>

            <!-- ── Connection Panel ──────────────────────────────────────── -->
            <Border Grid.Row="0" Background="White" CornerRadius="6"
                    Padding="14,10" Margin="0,0,0,8"
                    BorderBrush="#DDDDDD" BorderThickness="1">
                <WrapPanel>
                    <Label Content="Host:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                    <TextBox Style="{StaticResource InputBox}" Width="180" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="Port:" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <TextBox Style="{StaticResource InputBox}" Width="60"  Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="Version:" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <ComboBox Width="80" ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding Version}"
                              Padding="6,4" VerticalContentAlignment="Center"/>

                    <Label Content="Community:" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <TextBox Style="{StaticResource InputBox}" Width="120" Text="{Binding Community, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="Root OID:" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <TextBox Style="{StaticResource InputBox}" Width="200" Text="{Binding RootOid, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="Auto-Detect" Style="{StaticResource WarnBtn}" Margin="12,0,0,0"
                            Command="{Binding NegotiateCommand}"/>
                </WrapPanel>
            </Border>

            <!-- ── Action Bar ─────────────────────────────────────────────── -->
            <Border Grid.Row="1" Background="White" CornerRadius="6"
                    Padding="14,10" Margin="0,0,0,8"
                    BorderBrush="#DDDDDD" BorderThickness="1">
                <WrapPanel>
                    <Button Content="▶ Walk"        Style="{StaticResource PrimaryBtn}" Command="{Binding WalkCommand}"       Margin="0,0,8,0"/>
                    <Button Content="⤓ GET"          Style="{StaticResource PrimaryBtn}" Command="{Binding GetCommand}"        Margin="0,0,8,0"/>
                    <Button Content="✕ Cancel"       Style="{StaticResource DangerBtn}"  Command="{Binding CancelCommand}"     Margin="0,0,16,0"/>
                    <Button Content="🖨 Printer View" Style="{StaticResource PrimaryBtn}" Command="{Binding PrinterQuickViewCommand}" Margin="0,0,16,0"/>
                    <Button Content="Import MIB"    Style="{StaticResource PrimaryBtn}" Command="{Binding ImportMibCommand}"  Margin="0,0,8,0"/>
                    <Button Content="Export CSV"    Style="{StaticResource PrimaryBtn}" Command="{Binding ExportCsvCommand}"  Margin="0,0,8,0"/>
                    <Button Content="Export JSON"   Style="{StaticResource PrimaryBtn}" Command="{Binding ExportJsonCommand}" Margin="0,0,8,0"/>
                    <Button Content="📦 Diagnostics Bundle" Style="{StaticResource WarnBtn}" Command="{Binding ExportBundleCommand}" Margin="0,0,16,0"/>

                    <!-- Write mode toggle -->
                    <CheckBox Content="Enable Write Mode" IsChecked="{Binding WriteModeEnabled}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              Foreground="#C0392B" FontWeight="SemiBold"/>

                    <!-- SET fields (only visible in write mode) -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding WriteModeEnabled, Converter={StaticResource BoolVis}}">
                        <TextBox Style="{StaticResource InputBox}" Width="180" Text="{Binding SetOid}"
                                 ToolTip="OID to SET" Margin="0,0,4,0" Tag="OID"/>
                        <ComboBox Width="90" SelectedValue="{Binding SetType}" Padding="6,4"
                                  VerticalContentAlignment="Center" Margin="0,0,4,0">
                            <ComboBoxItem Content="INTEGER"/>
                            <ComboBoxItem Content="STRING"/>
                            <ComboBoxItem Content="OID"/>
                            <ComboBoxItem Content="TIMETICKS"/>
                            <ComboBoxItem Content="GAUGE"/>
                            <ComboBoxItem Content="COUNTER"/>
                        </ComboBox>
                        <TextBox Style="{StaticResource InputBox}" Width="140" Text="{Binding SetValue}"
                                 ToolTip="Value to set" Margin="0,0,4,0"/>
                        <Button Content="SET" Style="{StaticResource DangerBtn}" Command="{Binding SetCommand}"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- ── Results + Log Pane ─────────────────────────────────────── -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="1*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <!-- Results grid (virtualized) -->
                <Border Grid.Row="0" Background="White" CornerRadius="6"
                        BorderBrush="#DDDDDD" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Results}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FB"
                              RowBackground="White"
                              FontSize="12"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="OID"           Binding="{Binding Oid}"          Width="200"/>
                            <DataGridTextColumn Header="Symbolic Name" Binding="{Binding SymbolicName}" Width="180"/>
                            <DataGridTextColumn Header="Raw Value"     Binding="{Binding RawValue}"     Width="160"/>
                            <DataGridTextColumn Header="Human Value"   Binding="{Binding HumanValue}"   Width="200"/>
                            <DataGridTextColumn Header="Type"          Binding="{Binding Type}"         Width="110"/>
                            <DataGridTextColumn Header="Description"   Binding="{Binding Description}"  Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"
                              Background="#CCCCCC" ShowsPreview="True"/>

                <!-- Log Pane -->
                <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="6"
                        BorderBrush="#444466" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Background="#2A2A3E" LastChildFill="False">
                            <TextBlock Text="Diagnostics Log" Foreground="#AABBFF"
                                       FontWeight="SemiBold" Padding="10,6" FontSize="12"/>
                            <Button DockPanel.Dock="Right" Content="Clear" Margin="8,4"
                                    Style="{StaticResource DangerBtn}" FontSize="11"
                                    Command="{Binding ClearLogCommand}"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="11"
                                               Text="{Binding}" Foreground="#CCDDFF"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
