<Application x:Class="SNMP.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SNMP.App.Converters">
    <Application.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolVis"/>
        <conv:NullToVisibilityConverter  x:Key="NullVis"/>
        <conv:IntToVisibilityConverter   x:Key="IntVis"/>
    </Application.Resources>
</Application>
