    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SNMP.App</RootNamespace>
    <AssemblyName>SNMPStudio</AssemblyName>
    <Version>1.1.0</Version>
