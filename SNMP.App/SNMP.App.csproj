<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SNMP.App</RootNamespace>
    <AssemblyName>SNMPStudio</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>SNMP Studio</Product>
    <Company>Bennett Joseph</Company>
    <Copyright>Copyright © 2026 Bennett Joseph</Copyright>
  </PropertyGroup># Stage all modified files
git add -A

# Commit with a message
git commit -m "Your commit message here"

# Push to remote
git push

  <ItemGroup>
    <ProjectReference Include="..\SNMP.Core\SNMP.Core.csproj"/>
    <ProjectReference Include="..\SNMP.Engine\SNMP.Engine.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.Extensions.DependencyInjection — Microsoft-owned, ships with .NET.
      Pinned to 8.0.0 to match TargetFramework net8.0-windows.
      Do NOT upgrade to 9.x/10.x — would require bumping TFM.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0"/>

    <!--
      OxyPlot.Wpf — MIT-licensed open-source plotting library for WPF.
      Used exclusively on the Live Poll page for real-time sparkline charts.
      Latest stable: 2.2.0  (2.1.2 → 2.2.0, no breaking changes, .NET 8 verified)
    -->
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0"/>

    <!--
      NOTE: Microsoft.WindowsDesktop.App.WindowsForms has been REMOVED.
      The FolderBrowserDialog in DoExportBundleAsync has been replaced with
      WPF's native OpenFolderDialog (available since .NET 8 / WPF 8.0).
      This eliminates the only WinForms dependency from the application.
    -->
  </ItemGroup>
</Project>
